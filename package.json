{
  "name": "@linked.cm/capacitor",
  "description": "Native app helpers for sign-in, safe area, location, and updates.",
  "author": {
    "name": "",
    "email": "",
    "url": ""
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/linked-cm/capacitor.git"
  },
  "version": "0.3.0",
  "linkedPackage": true,
  "type": "module",
  "main": "lib/esm/index.js",
  "module": "lib/esm/index.js",
  "//types": "Correct as written, do not 'fix' it: typesVersions below is applied to the types field too, so \"index.d.ts\" resolves to lib/esm/index.d.ts. Writing that literal path applies the mapping twice (lib/esm/lib/esm/index.d.ts) and breaks node10 resolution. Verify with ts.resolveModuleName under node10 AND bundler, not by looking for the file on disk.",
  "types": "index.d.ts",
  "license": "ISC",
  "scripts": {
    "start": "linked dev",
    "test": "npm run build-esm && node --test tests/*.test.mjs",
    "build": "rimraf ./lib && npm run build-esm && npm run copy-to-lib",
    "build-esm": "echo \"compiling ESM\" && rimraf ./lib/esm && tsc -p tsconfig-esm.json",
    "copy-to-lib": "echo 'copying CSS + JSON assets to lib folder' && copyfiles -u 1 'src/**/*.css' 'src/**/*.json' lib/esm"
  },
  "keywords": [
    "linked",
    "linked data",
    "semantic web",
    "web3"
  ],
  "exports": {
    ".": {
      "types": "./lib/esm/index.d.ts",
      "import": "./lib/esm/index.js"
    },
    "./*.js": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    },
    "./*": {
      "types": "./lib/esm/*.d.ts",
      "import": "./lib/esm/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "lib/esm/*"
      ]
    }
  },
  "dependencies": {
    "@_linked/auth": "^3.1.0",
    "@_linked/core": "^2.27.0",
    "@_linked/primitives": "^1.8.0",
    "@_linked/react": "^2.0.0",
    "@_linked/schema": "^1.5.0",
    "@_linked/server-utils": "^1.12.0",
    "@_linked/sioc": "^1.4.0",
    "google-libphonenumber": "3.2.33",
    "react-international-phone": "4.0.4",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@_linked/cli": "^1.2",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/dialog": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capawesome/capacitor-app-update": "^7.2.0",
    "@capgo/capacitor-social-login": "7.20.0",
    "@capgo/capacitor-updater": "^7.4.0",
    "@changesets/changelog-github": "^0.5.2",
    "@changesets/cli": "^2.29.8",
    "@tolgee/react": "^5.33.0",
    "@types/node": "^20.12.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "capacitor-plugin-safe-area": "^4.0.3",
    "copyfiles": "^2.4.1",
    "rimraf": "^5.0.7",
    "typescript": "^5.7.3",
    "typescript-plugin-css-modules": "^5.1.0"
  },
  "peerDependencies": {
    "@capacitor/app": ">=7 <8",
    "@capacitor/core": ">=7 <8",
    "@capacitor/dialog": ">=7 <8",
    "@capacitor/geolocation": ">=7 <8",
    "@capacitor/preferences": ">=7 <8",
    "@capawesome/capacitor-app-update": ">=7 <8",
    "@capgo/capacitor-social-login": "7.20.0",
    "@capgo/capacitor-updater": ">=7 <8",
    "@tolgee/react": ">=5 <6",
    "capacitor-plugin-safe-area": ">=4 <5"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "npm@12.2.0"
}
